# ── Secrets & environment ──
.env
.env.*
!.env.example

# Porkbun/registrar exports — contain domain transfer AUTH CODES. Never commit.
hosting_information/

# ── User data, uploads, database ──
data/
uploads/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Manual test assets (large / licensed) ──
tests/fixtures/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# ── Internal project docs (keep private) ──
BUILD_PLAN.md
CLAUDE.md

# ── Editor / IDE / agent config (machine-specific) ──
# Ignore .claude CONTENTS (settings.json holds machine-specific permissions) but
# track the skills: they are shared project procedure, not local config. A bare
# `.claude/` would exclude the directory itself and no `!` rule could reach back
# inside it.
.claude/*
!.claude/skills/
.vscode/
.idea/
*.swp
*~

# ── OS junk ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ── Logs & temp ──
*.log
